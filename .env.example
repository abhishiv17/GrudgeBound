# Copy to .env and fill in. Never commit .env.

# --- NEAR AI Cloud (AI agents) ---
# Get a key at https://cloud.near.ai (free $10 credits via https://nearbuilders.org/join).
# Check https://docs.near.ai for the current API base URL and model names.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Cheapest model on NEAR AI Cloud; list the others with GET <base>/models.
NEAR_AI_MODEL=anthropic/claude-haiku-5-5

# --- NEAR testnet (contracts, relayer) ---
NEAR_NETWORK=testnet
NEAR_GAME_ACCOUNT=grudgebound.testnet
NEAR_ITEMS_CONTRACT=items.grudgebound.testnet
NEAR_RITE_CONTRACT=rite.grudgebound.testnet
# Relayer: pays the gas of players' relayed calls (default relayer.<NEAR_GAME_ACCOUNT>). Its key, like the game
# master's, is read from ~/.near-credentials when not set here. Keep keys out of git.
NEAR_RELAYER_ACCOUNT=relayer.grudgebound.testnet
NEAR_RELAYER_PRIVATE_KEY=
# Game master key. Optional: without it the server reads NEAR CLI's ~/.near-credentials/testnet/<NEAR_GAME_ACCOUNT>.json,
# and with neither, battles stay off-chain. NEAR_CHAIN=off forces off-chain.
NEAR_GAME_PRIVATE_KEY=
# Legacy guest account used by command-line tools; online game actions now require a session.
NEAR_GUEST_ACCOUNT=guest.grudgebound.testnet
# Online clients get their player account from email sign-in, never from Project Settings or a public env var.
# Default: FastNEAR (https://test.rpc.fastnear.com), ~3x faster than rpc.testnet.near.org.
NEAR_RPC_URL=

# --- Game server ---
# Hosting/disk paths and owner-only secret entry: docs/HOSTING.md. No hosting is performed by this file.
# Production: AUTH_STORE_PATH=/var/data/auth.enc, SATCHEL_STORE_PATH=/var/data/satchels.json,
# BATTLE_ARCHIVE=/var/data/battles.jsonl. Keep AUTH_SECRET with private backups, never in source.
PORT=8787
# Real milliseconds per tick (1 tick = 1 in-game hour). Default 60000 = 1 minute.
TICK_MS=60000
WORLD_SEED=2
# Enable only behind a trusted proxy that supplies the right-most X-Forwarded-For address.
TRUST_PROXY=0
# Rule proposal cooldown per account, milliseconds (OWNER default: 60 seconds).
RULE_PROPOSAL_COOLDOWN_MS=60000

# --- AI agents' own testnet accounts (P3-C2/A1) ---
# off: agents stay in the simulation only. Accounts agent-<id>.<NEAR_GAME_ACCOUNT> hold function-call keys only.
AGENT_CHAIN=on
# Encrypted with the auth store's key. Default: agents.enc beside AUTH_STORE_PATH.
AGENT_STORE_PATH=
# Spend cap: most Ember the game mints to one agent per in-game day; most agent-signed actions per day.
AGENT_DAILY_EMBER_CAP=200
AGENT_ACTIONS_PER_DAY=6

# --- Player sign-in (docs/SIGN_IN.md) ---
# Sign-in page opened by Unreal. HTTPS when NODE_ENV=production; loopback HTTP for development.
AUTH_SIGN_IN_URL=http://localhost:3000/sign-in
# 64 random hexadecimal characters. Required in production. Development creates data/auth.enc.key if omitted.
# Keep this key and the encrypted store backed up together, outside git.
AUTH_SECRET=
AUTH_STORE_PATH=data/auth.enc
# resend: real delivery (requires a verified sender); console: codes in the local server terminal, development only.
AUTH_EMAIL_MODE=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Team choice (7 Nov): encrypted server-held player signing, TESTNET ONLY. Never enable for mainnet.
# Player-held signing is not used by this demo; private keys stay in the encrypted server store.
AUTH_KEY_MODE=server
# Next.js server-side gateway. Set this in client/.env.local or the web host environment if not using localhost.
# This is not NEXT_PUBLIC_: the browser only calls /api/game.
GAME_SERVER_URL=http://localhost:8787
