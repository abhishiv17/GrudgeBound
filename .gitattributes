* text=auto eol=lf
*.jpeg binary
*.jpg binary
*.png binary
*.pdf binary
# Unreal assets are binary: stored with Git LFS
unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text lockable
unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text lockable
unreal/**/*.wav filter=lfs diff=lfs merge=lfs -text
unreal/**/*.ogg filter=lfs diff=lfs merge=lfs -text
unreal/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unreal/**/*.png filter=lfs diff=lfs merge=lfs -text
unreal/**/*.psd filter=lfs diff=lfs merge=lfs -text
