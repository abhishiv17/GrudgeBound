{
  "name": "grudgebound",
  "private": true,
  "version": "0.1.0",
  "description": "Grudgebound: The Rite - a creature-binding game where greed creates monsters and players rewrite the rules. Built at NEAR HACKATHON.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "sim",
    "server",
    "agents",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w @grudgebound/client",
    "build": "npm run build -w @grudgebound/client",
    "server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "server:watch": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "sim": "tsx sim/src/index.ts",
    "agent:demo": "tsx --env-file-if-exists=.env agents/src/demo.ts",
    "test": "tsx --test shared/src/shared.test.ts client/game/battle/battle.test.ts server/src/battles.test.ts server/src/unrealContract.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
